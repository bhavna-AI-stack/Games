# Environment Variables - Token Vesting DApp
# Copy this file to .env and fill in your values

# ============================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================

# Your wallet private key (WITHOUT 0x prefix is also OK)
# WARNING: NEVER commit .env to version control!
PRIVATE_KEY=your_private_key_here

# SCAI Mainnet RPC (default provided, override if needed)
SCAI_RPC_URL=https://mainnet-rpc.scai.network

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Deployed contract address (filled after deployment)
VITE_CONTRACT_ADDRESS=

# Chain ID (34 = SCAI Mainnet)
VITE_CHAIN_ID=34
