{
  "theme": {
    "archetype": "7",
    "name": "Electric & Neon (Dark Web3 Luxury)",
    "description": "Dark theme with blue and purple gradients, glassmorphism cards, modern DappRadar aesthetic.",
    "mode": "dark"
  },
  "colors": {
    "background": {
      "default": "bg-slate-950",
      "surface": "bg-slate-900/50",
      "glass": "bg-white/5 backdrop-blur-xl",
      "glassHover": "hover:bg-white/10"
    },
    "text": {
      "primary": "text-white",
      "secondary": "text-slate-400",
      "accent": "text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500"
    },
    "border": {
      "default": "border-white/10",
      "focus": "border-purple-500/50"
    },
    "gradients": {
      "primary": "bg-gradient-to-r from-blue-600 to-purple-600",
      "primaryHover": "hover:from-blue-500 hover:to-purple-500"
    }
  },
  "typography": {
    "fonts": {
      "heading": "Outfit, sans-serif",
      "body": "Manrope, sans-serif"
    },
    "sizes": {
      "h1": "text-4xl sm:text-5xl lg:text-6xl tracking-tight font-black",
      "h2": "text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold",
      "h3": "text-xl sm:text-2xl tracking-tight font-semibold",
      "body": "text-base leading-relaxed",
      "small": "text-sm"
    }
  },
  "layout": {
    "spacing": {
      "section": "py-20 md:py-32",
      "container": "container mx-auto px-4 md:px-8",
      "cardPadding": "p-6"
    },
    "borderRadius": {
      "card": "rounded-2xl",
      "button": "rounded-xl",
      "badge": "rounded-full"
    },
    "grid": {
      "gamesList": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6",
      "bentoDashboard": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6"
    }
  },
  "components": {
    "cards": {
      "style": "bg-white/5 border border-white/10 backdrop-blur-xl rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-purple-500/30 hover:shadow-[0_8px_30px_rgba(139,92,246,0.1)]",
      "imageWrapper": "relative aspect-video w-full overflow-hidden",
      "content": "p-5 flex flex-col gap-3"
    },
    "buttons": {
      "primary": "inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium transition-all hover:shadow-[0_0_20px_rgba(139,92,246,0.4)] hover:scale-105",
      "secondary": "inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-medium transition-all hover:bg-white/20"
    },
    "badges": {
      "genre": "absolute top-3 left-3 bg-black/60 backdrop-blur-md border border-white/10 text-white text-xs px-3 py-1 rounded-full font-medium"
    }
  },
